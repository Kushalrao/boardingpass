<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Flight path row: ORIGIN ●━━━✈╌╌╌● DEST -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/origin_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/notification_dot_green" />

        <!-- Flight path with airplane overlay -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ProgressBar
                android:id="@+id/notification_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progressDrawable="@drawable/notification_flight_path" />

            <FrameLayout
                android:id="@+id/flight_icon_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/flight_progress_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_flight_progress" />
            </FrameLayout>
        </FrameLayout>

        <ImageView
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/notification_dot_green" />

        <TextView
            android:id="@+id/dest_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status text (e.g. "On Time", "In Flight") -->
    <TextView
        android:id="@+id/notification_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FF4CAF50"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Subtitle / time info -->
    <TextView
        android:id="@+id/notification_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" />
</LinearLayout>
