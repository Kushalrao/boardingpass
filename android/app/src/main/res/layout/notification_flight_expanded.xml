<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header: flight number left, arrival time + destination right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exp_flight_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/exp_arrival_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Origin + departure time -->
    <TextView
        android:id="@+id/exp_departure_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Flight path: ●━━━━━━━━━━✈╌╌╌╌╌╌╌╌● -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:importantForAccessibility="no"
            android:src="@drawable/notification_dot_green" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ProgressBar
                android:id="@+id/exp_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progressDrawable="@drawable/notification_flight_path" />

            <FrameLayout
                android:id="@+id/exp_flight_icon_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_flight_progress" />
            </FrameLayout>
        </FrameLayout>

        <ImageView
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:importantForAccessibility="no"
            android:src="@drawable/notification_dot_green" />
    </LinearLayout>

    <!-- Status row: status left, time remaining right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exp_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF4CAF50"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/exp_time_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Additional details (gate, terminal, baggage, etc.) -->
    <TextView
        android:id="@+id/exp_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" />
</LinearLayout>
